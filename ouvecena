#!/bin/bash
# Uso: ouvecena <video|audio> [--quadros N] [--contexto] [--corte W:H:X:Y] [--saida DIR]
set -e
D="$(cd "$(dirname "$0")" && pwd)"; Q=0; C=0; CR=""; OUT="$D/saida"; IN=""
while [ $# -gt 0 ]; do case "$1" in
  --quadros) Q="$2"; shift 2;; --contexto) C=1; shift;; --corte) CR="$2"; shift 2;; --saida) OUT="$2"; shift 2;; *) IN="$1"; shift;; esac; done
[ -f "$IN" ] || { echo "uso: ouvecena <arquivo> [--quadros N] [--saida DIR]"; exit 1; }
FF=/opt/homebrew/bin/ffmpeg; N="$(basename "${IN%.*}")"; mkdir -p "$OUT"; T="$(mktemp -d)"
$FF -v error -y -i "$IN" -vn -ar 16000 -ac 1 "$T/a.wav"
whisper-cli -m "$D/modelos/ggml-large-v3-turbo-q5_0.bin" -l pt -f "$T/a.wav" -of "$T/o" -oj -np >/dev/null 2>&1
python3 -I - "$T/o.json" "$OUT/$N.txt" <<'PY'
import json,sys
def t(ms): s=ms/1000; return f"{int(s//60):02d}:{s%60:05.2f}"
seg=json.load(open(sys.argv[1]))["transcription"]
open(sys.argv[2],"w").write("".join(f"[{t(x['offsets']['from'])} --> {t(x['offsets']['to'])}] {x['text'].strip()}\n" for x in seg))
PY
echo "$OUT/$N.txt"
[ "$C" = 1 ] && python3 -I "$D/contexto.py" "$FF" "$IN" "$T/o.json" "$OUT/$N" $CR
if [ "$Q" != 0 ]; then
  $FF -v error -y -i "$IN" -vf "fps=1/$Q,scale=-2:320,drawtext=text='%{eif\:t*$Q\:d}s':x=4:y=4:fontsize=18:fontcolor=yellow:box=1:boxcolor=black@0.6" -frames:v 400 "$T/q%03d.png" 2>/dev/null || \
  $FF -v error -y -i "$IN" -vf "fps=1/$Q,scale=-2:320" "$T/q%03d.png"
  K=$(ls "$T"/q*.png | wc -l)
  $FF -v error -y -framerate 1 -i "$T/q%03d.png" -vf "tile=6x$(( (K+5)/6 ))" -frames:v 1 "$OUT/$N-quadros.png" 
  echo "$OUT/$N-quadros.png (quadro i = (i-1)*${Q}s, leitura esq→dir, cima→baixo)"
fi
rm -rf "$T"
